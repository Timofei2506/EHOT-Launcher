<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       EHOT Launcher · компоненты дизайн-системы
       ============================================================ -->

  <Styles.Resources>

      <ControlTheme x:Key="EhotButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.15" />
            <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Name="Content"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="EhotPrimaryButton" TargetType="Button" BasedOn="{StaticResource EhotButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style Selector="^ /template/ Border#Root">
      <Setter Property="BoxShadow" Value="0 10 26 -10 #A68B5CF6" />
    </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource AccentGradientHorizontal}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Opacity" Value="0.9" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="EhotGhostButton" TargetType="Button" BasedOn="{StaticResource EhotButton}">
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="EhotDangerButton" TargetType="Button" BasedOn="{StaticResource EhotButton}">
        <Setter Property="Background" Value="#2A1518" />
        <Setter Property="BorderBrush" Value="#5A2A30" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      </ControlTheme>

      <ControlTheme x:Key="EhotIconButton" TargetType="Button" BasedOn="{StaticResource EhotButton}">
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
      </ControlTheme>

      <!-- Поле ввода: наследуем шаблон Fluent (в Avalonia 12 внутренний презентер
           текста не публичный), но перекрашиваем фон, рамку и фокус через
           ControlTheme Fluent — это официальные ключи темы. -->
      <ControlTheme x:Key="EhotTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}" />
        <Setter Property="SelectionBrush" Value="#5538BDF8" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="PlaceholderForeground" Value="#7C8AA0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style Selector="^:pointerover">
          <Setter Property="BorderBrush" Value="#3A4360" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </ControlTheme>

      <!-- Комбобокс: тот же вид, что у поля ввода, но шаблон — штатный Fluent
           (свой шаблон требует внутренний popup-контрол, который не публичный). -->
      <ControlTheme x:Key="EhotComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:pointerover">
          <Setter Property="BorderBrush" Value="#3A4360" />
        </Style>
        <Style Selector="^:focus /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
        </Style>
      </ControlTheme>

      <!-- Чекбокс: квадрат 18×18 со скруглением 6, галочка акцентным цветом. -->
      <ControlTheme x:Key="EhotCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Background="Transparent">
              <Border Name="Box" Width="18" Height="18" CornerRadius="6"
                      Background="{StaticResource SecondaryBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path Name="Check" Data="{StaticResource IconCheck}"
                      Stroke="#FFFFFF" StrokeThickness="2" Fill="Transparent"
                      Width="11" Height="11" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
              </Border>
              <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Box">
          <Setter Property="BorderBrush" Value="#3A4360" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box">
          <Setter Property="Background" Value="{StaticResource AccentGradientHorizontal}" />
          <Setter Property="BorderBrush" Value="#00000000" />
        </Style>
        <Style Selector="^:checked /template/ Path#Check">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>

      <!-- Кнопка-«таблетка»: для строк списков (Установить, Открыть…). -->
      <ControlTheme x:Key="EhotPillButton" TargetType="Button" BasedOn="{StaticResource EhotButton}">
        <Setter Property="Background" Value="#1A2033" />
        <Setter Property="BorderBrush" Value="#2A3350" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontSize" Value="12" />
      </ControlTheme>

      <ControlTheme x:Key="NavItemTheme" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Name="IconHost"
                                  Content="{TemplateBinding Tag}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,11,0" />
                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Content}"
                                  VerticalAlignment="Center"
                                  TextElement.FontSize="13.5"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <Border Grid.Column="2" Name="Indicator" Width="3" Height="16" CornerRadius="2"
                        Background="{StaticResource AccentBrush}" Opacity="0" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>
        <Style Selector="^:checked /template/ Border#Root">
          <Setter Property="Background" Value="#1A8B5CF6" />
        </Style>
        <Style Selector="^:checked /template/ Border#Indicator">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
      </ControlTheme>

  </Styles.Resources>


  <!-- ══════════════ Кнопки: классовые варианты ══════════════
       В разметке используются классы (.primary, .ghost, .danger, .icon),
       поэтому варианты заданы стилями, а не только ControlTheme по ключу. -->

  <Style Selector="Button">
    <Setter Property="Theme" Value="{StaticResource EhotButton}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Theme" Value="{StaticResource EhotPrimaryButton}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Theme" Value="{StaticResource EhotGhostButton}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Theme" Value="{StaticResource EhotDangerButton}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Theme" Value="{StaticResource EhotIconButton}" />
  </Style>

  <!-- ══════════════ Кнопки окна (свернуть / во весь экран / закрыть) ══════════════
       Один размер, один вес штриха, центрированный глиф. Ховер — мягкая подложка,
       у закрытия — красная, как принято в Windows. -->
  <Style Selector="Button.window">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.window /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.window:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>

  <Style Selector="Button.window:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <Style Selector="Button.window Path">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="#B9C2D4" />
    <Setter Property="StrokeThickness" Value="1.25" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.window:pointerover Path">
    <Setter Property="Stroke" Value="#FFFFFF" />
  </Style>

  <!-- Закрытие: красная подложка и белый крестик -->
  <Style Selector="Button.window.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D9383F" />
  </Style>

  <Style Selector="Button.window.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B3262C" />
  </Style>

  <!-- Кнопка «таблетка» для второстепенных действий в списках -->
  <Style Selector="Button.pill">
    <Setter Property="Theme" Value="{StaticResource EhotPillButton}" />
  </Style>

  <!-- ══════════════ Поля ввода ══════════════
       Fluent рисует фон/рамку вокруг ContentPresenter (Border#PART_BorderElement),
       а не на самом TextBox — поэтому перекрашиваем именно шаблон. -->

  <Style Selector="TextBox">
    <Setter Property="Theme" Value="{StaticResource EhotTextBox}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Theme" Value="{StaticResource EhotComboBox}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Theme" Value="{StaticResource EhotCheckBox}" />
  </Style>

  <!-- Карточка -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardGradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="0 10 30 0 #3D000000" />
  </Style>

  <Style Selector="Border.glass">
    <Setter Property="Background" Value="#12151FCC" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{StaticResource HeroGradient}" />
    <Setter Property="BorderBrush" Value="#2A2145" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="BoxShadow" Value="0 18 48 -12 #66000000" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="BorderBrush" Value="#22FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <!-- Текст -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
  </Style>

  <!-- Иконка -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Path.icon.accent">
    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Path.icon.blue">
    <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}" />
  </Style>

  <!-- Навигация -->

  <!-- Прогресс -->
  <Style Selector="ProgressBar.ehot">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource AccentGradientHorizontal}" />
    <Setter Property="MinWidth" Value="40" />
  </Style>

  <!-- Прокрутка -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Разделитель -->
  <Style Selector="Rectangle">
    <Setter Property="Fill" Value="{StaticResource BorderSoftBrush}" />
  </Style>

</Styles>
