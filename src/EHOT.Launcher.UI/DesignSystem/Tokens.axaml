<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       EHOT Launcher · дизайн-токены
       Все цвета, радиусы, отступы и типографика — только отсюда.
       ============================================================ -->

  <!-- Палитра (базовая из ТЗ) -->
  <Color x:Key="ColorBackground">#0B0D13</Color>
  <Color x:Key="ColorSecondary">#151923</Color>
  <Color x:Key="ColorSurface">#20263A</Color>
  <Color x:Key="ColorPurple">#8B5CF6</Color>
  <Color x:Key="ColorBlue">#38BDF8</Color>
  <Color x:Key="ColorText">#F8FAFC</Color>
  <Color x:Key="ColorTextSecondary">#94A3B8</Color>

  <!-- Производные -->
  <Color x:Key="ColorSurfaceHigh">#272E45</Color>
  <Color x:Key="ColorBorder">#2A3147</Color>
  <Color x:Key="ColorBorderSoft">#1E2434</Color>
  <Color x:Key="ColorSuccess">#34D399</Color>
  <Color x:Key="ColorWarning">#FBBF24</Color>
  <Color x:Key="ColorDanger">#F87171</Color>
  <Color x:Key="ColorPurpleSoft">#1C1930</Color>
  <Color x:Key="ColorBlueSoft">#0F2333</Color>

  <!-- Кисти -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ColorSecondary}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource ColorSurfaceHigh}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
  <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource ColorBorderSoft}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorPurple}" />
  <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource ColorBlue}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- Градиенты -->
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#8B5CF6" Offset="0" />
    <GradientStop Color="#6366F1" Offset="0.55" />
    <GradientStop Color="#38BDF8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#8B5CF6" Offset="0" />
    <GradientStop Color="#38BDF8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#221B3E" Offset="0" />
    <GradientStop Color="#141A2C" Offset="0.6" />
    <GradientStop Color="#0E1220" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#20263A" Offset="0" />
    <GradientStop Color="#181D2C" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GlassOverlay" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#26FFFFFF" Offset="0" />
    <GradientStop Color="#08FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#12151F" Offset="0" />
    <GradientStop Color="#0D1017" Offset="1" />
  </LinearGradientBrush>

  <!-- Радиусы -->
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">12</CornerRadius>
  <CornerRadius x:Key="RadiusLg">18</CornerRadius>
  <CornerRadius x:Key="RadiusXl">24</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <x:Double x:Key="RadiusSmValue">8</x:Double>
  <x:Double x:Key="RadiusMdValue">12</x:Double>

  <!-- Тени -->
  <BoxShadows x:Key="ShadowSoft">0 8 24 0 #40000000</BoxShadows>
  <BoxShadows x:Key="ShadowCard">0 10 30 0 #55000000</BoxShadows>
  <BoxShadows x:Key="ShadowAccent">0 12 32 -6 #668B5CF6</BoxShadows>

  <!-- Типографика -->
  <x:Double x:Key="FontDisplay">40</x:Double>
  <x:Double x:Key="FontH1">26</x:Double>
  <x:Double x:Key="FontH2">20</x:Double>
  <x:Double x:Key="FontH3">16</x:Double>
  <x:Double x:Key="FontBody">13.5</x:Double>
  <x:Double x:Key="FontSmall">12</x:Double>
  <x:Double x:Key="FontTiny">11</x:Double>

  <!-- Иконки (геометрия 24×24, stroke-подобные контуры) -->
  <StreamGeometry x:Key="IconHome">M12 3.2 3.6 10v10.2h5.6v-6h5.6v6h5.6V10z</StreamGeometry>
  <StreamGeometry x:Key="IconPlay">M8 5.2 18.6 12 8 18.8z</StreamGeometry>
  <StreamGeometry x:Key="IconLayers">M12 3 3 7.5 12 12l9-4.5zM3 12.2l9 4.5 9-4.5M3 16.8l9 4.5 9-4.5</StreamGeometry>
  <StreamGeometry x:Key="IconPuzzle">M9 3h3v2.2a1.8 1.8 0 1 0 3.6 0V3H19a1 1 0 0 1 1 1v4.4h-2.2a1.8 1.8 0 1 0 0 3.6H20V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8h2.2a1.8 1.8 0 1 0 0-3.6H4V4a1 1 0 0 1 1-1z</StreamGeometry>
  <StreamGeometry x:Key="IconBox">M12 3 4 7v10l8 4 8-4V7zM4 7l8 4 8-4M12 11v10</StreamGeometry>
  <StreamGeometry x:Key="IconBrush">M4 20c0-3 2-4 3-6l9-9 3 3-9 9c-2 1-3 3-6 3zM14 6l4 4</StreamGeometry>
  <StreamGeometry x:Key="IconSparkle">M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 16l.9 2.1L22 19l-2.1.9L19 22l-.9-2.1L16 19l2.1-.9z</StreamGeometry>
  <StreamGeometry x:Key="IconMap">M9 4 3 6.5V20l6-2.5 6 2.5 6-2.5V4l-6 2.5zM9 4v13.5M15 6.5V20</StreamGeometry>
  <StreamGeometry x:Key="IconNetwork">M12 3a2.2 2.2 0 1 1 0 4.4A2.2 2.2 0 0 1 12 3zM5 16.6a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM19 16.6a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM12 7.4v5.2M12 12.6 6.4 16.4M12 12.6l5.6 3.8</StreamGeometry>
  <StreamGeometry x:Key="IconUser">M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8zM4.5 20.2c0-3.6 3.4-5.8 7.5-5.8s7.5 2.2 7.5 5.8</StreamGeometry>
  <StreamGeometry x:Key="IconDownload">M12 3.5v10.8M8.2 10.6 12 14.4l3.8-3.8M4.5 16.5v2.2a1.8 1.8 0 0 0 1.8 1.8h11.4a1.8 1.8 0 0 0 1.8-1.8v-2.2</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M12 8.6a3.4 3.4 0 1 1 0 6.8 3.4 3.4 0 0 1 0-6.8zM19.2 12c0-.5 0-1-.1-1.4l2-1.4-1.9-3.3-2.3.9c-.7-.5-1.4-.9-2.2-1.2L14.3 3h-3.9l-.4 2.6c-.8.3-1.5.7-2.2 1.2l-2.3-.9-1.9 3.3 2 1.4c-.1.4-.1.9-.1 1.4s0 1 .1 1.4l-2 1.4 1.9 3.3 2.3-.9c.7.5 1.4.9 2.2 1.2l.4 2.6h3.9l.4-2.6c.8-.3 1.5-.7 2.2-1.2l2.3.9 1.9-3.3-2-1.4c.1-.4.1-.9.1-1.4z</StreamGeometry>
  <StreamGeometry x:Key="IconInfo">M12 3.4a8.6 8.6 0 1 1 0 17.2 8.6 8.6 0 0 1 0-17.2zM12 10.2v6M12 7.4v.2</StreamGeometry>  <StreamGeometry x:Key="IconImport">M3 3v18h18V3H3zm2 16V5h14l-.002.156.002.156V19H5zM7 5h10a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1m0 2h10v10H7z</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M10.6 4a6.6 6.6 0 1 1 0 13.2 6.6 6.6 0 0 1 0-13.2zM15.4 15.4 20 20</StreamGeometry>
  <StreamGeometry x:Key="IconBell">M12 3.6a5.4 5.4 0 0 1 5.4 5.4v4l1.6 3H5l1.6-3v-4A5.4 5.4 0 0 1 12 3.6zM9.6 19.2a2.5 2.5 0 0 0 4.8 0</StreamGeometry>
  <StreamGeometry x:Key="IconMinimize">M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="IconMaximize">M6 6h12v12H6z</StreamGeometry>
  <!-- Аккуратные глифы окна: одинаковый визуальный вес у всех трёх кнопок -->
  <StreamGeometry x:Key="IconWinMinimize">M5 11h14</StreamGeometry>
  <StreamGeometry x:Key="IconWinMaximize">M5.5 5.5h13v13h-13z</StreamGeometry>
  <StreamGeometry x:Key="IconWinRestore">M5 8.5h10.5v10.5H5zM8.5 8.5V5H19v10.5h-3.5</StreamGeometry>
  <StreamGeometry x:Key="IconWinClose">M7 7l10 10M17 7L7 17</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6 6l12 12M18 6 6 18</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M5 13l4.2 4.2L19 7</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M12 3.6 21 19H3zM12 9.4v4.2M12 16.4v.2</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3.6 6.4A1.4 1.4 0 0 1 5 5h4l2 2.4h6.6a1.4 1.4 0 0 1 1.4 1.4v8.8A1.4 1.4 0 0 1 17.6 19H5a1.4 1.4 0 0 1-1.4-1.4z</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M20 12a8 8 0 1 1-2.6-5.9M20 4v4.4h-4.4</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M5 7h14M9.5 7V4.6h5V7M7 7l.8 12.2h8.4L17 7M10.4 10.4v6M13.6 10.4v6</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M9 5l7 7-7 7</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M5 9l7 7 7-7</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M9 9V5.4A1.4 1.4 0 0 1 10.4 4H19a1 1 0 0 1 1 1v8.6a1.4 1.4 0 0 1-1.4 1.4H15M4 9.4A1.4 1.4 0 0 1 5.4 8H14a1 1 0 0 1 1 1v9.6a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 18.6z</StreamGeometry>
  <StreamGeometry x:Key="IconExternal">M14 4h6v6M20 4l-8.4 8.4M18 14v4.6A1.4 1.4 0 0 1 16.6 20H5.4A1.4 1.4 0 0 1 4 18.6V7.4A1.4 1.4 0 0 1 5.4 6H10</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M8.6 5h2.2v14H8.6zM13.2 5h2.2v14h-2.2z</StreamGeometry>

  <!-- Единый размер иконки -->
  <x:Double x:Key="IconSize">18</x:Double>
</ResourceDictionary>
