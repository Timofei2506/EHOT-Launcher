<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:models="using:EHOT.Launcher.Core.Models"
             x:Class="EHOT.Launcher.UI.Views.PlayView"
             x:DataType="vm:PlayViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="14">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Играть" Classes="h1" />
        <TextBlock Text="Профили, параметры Java, установка и запуск Minecraft" Classes="body" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="ghost" Command="{Binding InstallVersionCommand}" Content="Установить версию" />
        <Button Classes="primary" Command="{Binding LaunchCommand}" Content="Запустить" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="14">

      <!-- Список профилей -->
      <Border Classes="card" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="Профили" Classes="h3" />
            <TextBox Classes="ehot" Text="{Binding NewProfileName, Mode=TwoWay}" PlaceholderText="Название профиля" />
            <ComboBox ItemsSource="{Binding MinecraftVersions}" SelectedItem="{Binding NewProfileVersion, Mode=TwoWay}"
                      PlaceholderText="Версия Minecraft" HorizontalAlignment="Stretch" />
            <ComboBox ItemsSource="{Binding AvailableLoaders}" SelectedItem="{Binding NewProfileLoader, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
            <Button Classes="primary" Command="{Binding CreateProfileCommand}" Content="Создать профиль"
                    HorizontalAlignment="Stretch" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,12,0,12">
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GameProfile">
                  <Border Classes="card" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                 Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DisplayVersion}" Classes="caption" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="ghost" Padding="8,4" FontSize="10.5"
                                Command="{Binding $parent[ItemsControl].((vm:PlayViewModel)DataContext).SelectProfileCommand}"
                                CommandParameter="{Binding}" Content="Выбрать" />
                        <Button Classes="ghost" Padding="8,4" FontSize="10.5"
                                Command="{Binding $parent[ItemsControl].((vm:PlayViewModel)DataContext).CloneProfileCommand}"
                                CommandParameter="{Binding}" Content="Копия" />
                        <Button Classes="danger" Padding="8,4" FontSize="10.5"
                                Command="{Binding $parent[ItemsControl].((vm:PlayViewModel)DataContext).DeleteProfileCommand}"
                                CommandParameter="{Binding}" Content="Удалить" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Classes="caption" TextWrapping="Wrap"
                     Text="Удаление профиля убирает его из лаунчера; папка с файлами остаётся на диске." />
        </Grid>
      </Border>

      <!-- Настройки выбранного профиля -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="Выбранный профиль" Classes="h3" />
              <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='Профиль не выбран'}" Classes="h2" />
              <TextBlock Text="{Binding SelectedProfile.InstanceDirectory, FallbackValue='—'}" Classes="caption" />

              <Border Classes="divider" />

              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                <TextBlock Text="Оперативная память" Classes="body" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding MemoryMb, StringFormat='{}{0} МБ'}" Classes="h3"
                           HorizontalAlignment="Right" Margin="0,0,10,0" />
                <Slider Grid.Column="2" Width="260" Minimum="1024" Maximum="{Binding MaxMemoryMb}"
                        Value="{Binding MemoryMb, Mode=TwoWay}" TickFrequency="512" />

                <TextBlock Grid.Row="1" Text="Java" Classes="body" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding JavaRuntimes}" SelectedItem="{Binding SelectedJava, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <TextBox Classes="ehot" Text="{Binding JvmArgs, Mode=TwoWay}"
                       PlaceholderText="Дополнительные JVM-аргументы (например -XX:+UseG1GC)" />

              <ComboBox ItemsSource="{Binding MinecraftVersions}" SelectedItem="{Binding NewProfileVersion, Mode=TwoWay}"
                        PlaceholderText="Версия Minecraft для установки" HorizontalAlignment="Stretch" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SaveSettingsCommand}" Content="Сохранить настройки" />
                <Button Classes="ghost" Command="{Binding InstallVersionCommand}" Content="Установить" />
                <Button Classes="ghost" Command="{Binding StopCommand}" Content="Остановить игру" IsVisible="{Binding IsRunning}" />
              </StackPanel>

              <Border Classes="divider" />
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding InstallStatusText}" Classes="caption" />
                <ProgressBar Classes="ehot" Value="{Binding InstallProgress}" Maximum="1" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Аккаунт для запуска" Classes="h3" />
              <ComboBox ItemsSource="{Binding JavaRuntimes}" IsVisible="False" />
              <TextBlock Text="{Binding SelectedAccount.Username, FallbackValue='Аккаунт не выбран'}" Classes="body" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Локальные профили запускаются в оффлайн-режиме. Для официальных серверов подключите Microsoft-аккаунт в разделе «Аккаунты»." />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
