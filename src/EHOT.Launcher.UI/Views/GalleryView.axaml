<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:imgs="using:EHOT.Launcher.UI.Converters"
             x:Class="EHOT.Launcher.UI.Views.GalleryView"
             x:DataType="vm:GalleryViewModel">

  <Grid>
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Галерея" Classes="h1" />
          <TextBlock Text="Скриншоты из папки screenshots общей игры и инстансов" Classes="body" />
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                  VerticalAlignment="Center" Width="210" ToolTip.Tip="Фильтр по папке-источнику" />
        <Button Grid.Column="2" Classes="ghost" Command="{Binding RefreshCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconRefresh}" Classes="icon" Width="15" Height="15" />
            <TextBlock Text="Обновить" FontSize="12.5" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:GalleryItem" xmlns:services="using:EHOT.Launcher.UI.Services">
                <Button Classes="ghost" Padding="8" Margin="0,0,12,12" Background="{StaticResource GlassCardBrush}"
                        Command="{Binding $parent[ItemsControl].((vm:GalleryViewModel)DataContext).OpenPreviewCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="8">
                    <Border Height="150" CornerRadius="12" Background="#181A20" ClipToBounds="True">
                      <Image Source="{Binding FullPath, Converter={x:Static imgs:LocalThumbnailConverter.Instance}, ConverterParameter=420}"
                             Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding FileName}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding SourceLabel}" Classes="caption" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Classes="caption" FontSize="9.5" />
                    </Grid>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding !HasItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <Image Source="avares://EHOT.Launcher/Assets/mascot-raccoon.png" Width="150" Height="150" Stretch="Uniform" Opacity="0.9" />
            <TextBlock Text="Скриншотов пока нет" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Нажмите F2 в игре — снимок появится здесь автоматически." Classes="caption" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Полноэкранный просмотр -->
    <Border IsVisible="{Binding IsFullscreenOpen}" Background="#E6111216" ZIndex="20">
      <Grid RowDefinitions="Auto,*,Auto" Margin="28">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding SelectedItem.FileName}" Classes="h3" />
            <TextBlock Text="{Binding SelectedItem.DateLabel}" Classes="caption" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon" Command="{Binding CloseFullscreenCommand}" ToolTip.Tip="Закрыть">
            <Path Data="{StaticResource IconClose}" Classes="icon" />
          </Button>
        </Grid>
        <Border Grid.Row="1" Margin="0,16" CornerRadius="16" ClipToBounds="True" Background="#181A20">
          <Image Source="{Binding SelectedItem.FullPath, Converter={x:Static imgs:LocalThumbnailConverter.Instance}, ConverterParameter=1400}"
                 Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Classes="ghost" Command="{Binding OpenOriginalCommand}" Content="Открыть оригинал" />
          <Button Classes="ghost" Command="{Binding CopyImageCommand}" Content="Копировать" />
          <Button Classes="ghost" Command="{Binding OpenFolderCommand}" Content="Открыть папку" />
          <Button Classes="danger" Command="{Binding AskDeleteCommand}" Content="Удалить" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Подтверждение удаления -->
    <Border IsVisible="{Binding ItemPendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#CC111216" ZIndex="30">
      <Border Classes="card glass-card" Width="460" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Удалить скриншот?" Classes="h3" />
          <TextBlock Text="{Binding ItemPendingDelete.FileName}" Classes="caption" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Файл будет удалён с диска без возможности восстановления." Classes="caption" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding CancelDeleteCommand}" Content="Отмена" />
            <Button Classes="danger" Command="{Binding ConfirmDeleteCommand}" Content="Удалить" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
