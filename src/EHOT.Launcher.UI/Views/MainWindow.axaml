<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
        xmlns:conv="using:EHOT.Launcher.UI.Converters"
        xmlns:services="using:EHOT.Launcher.UI.Services"
        x:Class="EHOT.Launcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EHOT Launcher"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica, Blur, None">

  <Window.Resources>
    <conv:IconKeyConverter x:Key="IconKey" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:ToastKindBrushConverter x:Key="ToastBrush" />
    <conv:SelectedBackgroundConverter x:Key="SelectedBackground" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- ══════════════ Titlebar ══════════════ -->
    <Grid Grid.Row="0" Height="46" Background="#10131C" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
        <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentGradient}">
          <TextBlock Text="E" FontSize="13" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="EHOT Launcher" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        <Border Classes="chip" Padding="8,2" VerticalAlignment="Center" Background="#1A8B5CF6">
          <TextBlock Text="BETA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
        </Border>
      </StackPanel>

      <!-- Перетаскивание окна -->
      <Border Grid.Column="1" Background="Transparent" PointerPressed="OnTitleBarPressed" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
        <Button Classes="ghost" Width="46" Height="46" CornerRadius="0"
                Click="OnMinimizeClick" ToolTip.Tip="Свернуть">
          <Path Data="{StaticResource IconMinimize}" Stroke="{StaticResource TextSecondaryBrush}"
                StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" />
        </Button>
        <Button Classes="ghost" Width="46" Height="46" CornerRadius="0"
                Click="OnMaximizeClick" ToolTip.Tip="Развернуть">
          <Path Data="{StaticResource IconMaximize}" Stroke="{StaticResource TextSecondaryBrush}"
                StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
        </Button>
        <Button Width="46" Height="46" CornerRadius="0" Background="Transparent" BorderThickness="0"
                Click="OnCloseClick" ToolTip.Tip="Закрыть">
          <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondaryBrush}"
                StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
          <Button.Styles>
            <Style Selector="Button:pointerover">
              <Setter Property="Background" Value="#F87171" />
            </Style>
          </Button.Styles>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══════════════ Основная область ══════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="236,*,300">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="#141824" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <StackPanel Grid.Row="0" Margin="16,18,16,10" Spacing="12">
            <Button Command="{Binding ToggleSearchCommand}" Classes="ghost"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="11,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="{StaticResource IconSearch}" Classes="icon" />
                <TextBlock Grid.Column="1" Text="Поиск по каталогу" Margin="9,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="chip" Padding="6,1">
                  <TextBlock Text="⌘K" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,4,10,0">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                  <Button Classes="ghost" Command="{Binding SelectCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="0" Background="Transparent" BorderThickness="0">
                    <Border CornerRadius="10" Padding="12,9" Margin="0,1"
                            Background="{Binding IsSelected, Converter={StaticResource SelectedBackground}}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}" Classes="icon"
                              Stroke="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="11,0,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Аккаунт внизу сайдбара -->
          <Border Grid.Row="2" Margin="12" Padding="12" CornerRadius="14" Background="#141926"
                  BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
            <Button Command="{Binding OpenProfileCommand}" Background="Transparent" BorderThickness="0"
                    Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}">
                  <TextBlock Text="{Binding AccountInitials}" FontWeight="Bold" FontSize="14"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding AccountKindLabel}" FontSize="10.5"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Button>
          </Border>
        </Grid>
      </Border>

      <!-- Контент -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="26,18,26,8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding CurrentPage.ErrorMessage, FallbackValue=''}" Classes="caption"
                       Foreground="{StaticResource DangerBrush}" IsVisible="{Binding CurrentPage.HasError}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding OpenNotificationsCommand}" ToolTip.Tip="Уведомления">
              <Path Data="{StaticResource IconBell}" Classes="icon" />
            </Button>
            <Border Classes="chip" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NetworkIndicator}" FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="26,0,26,18" />
      </Grid>

      <!-- Правая колонка: контекст -->
      <Border Grid.Column="2" Background="#0E1119" BorderBrush="#141824" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,20" Spacing="14">

            <TextBlock Text="ТЕКУЩИЙ ПРОФИЛЬ" Classes="eyebrow" />

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding ProfileName}" Classes="h3" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProfileVersion}" Classes="caption" />
                <Border Classes="divider" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="Платформа" Classes="caption" />
                  <TextBlock Grid.Column="1" Text="{Binding PlatformLabel}" Classes="caption"
                             HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                  <TextBlock Grid.Row="1" Text="Аккаунт" Classes="caption" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccountName}" Classes="caption" Margin="0,4,0,0"
                             HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="СОСТОЯНИЕ СИСТЕМ" Classes="eyebrow" Margin="0,6,0,0" />

            <ItemsControl ItemsSource="{Binding CapabilityRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CapabilityRow">
                  <Border Padding="0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,0,0" FontSize="12"
                                 Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="10"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="divider" />

            <TextBlock Text="EHOT GAME NETWORK" Classes="eyebrow" />
            <TextBlock Classes="body" FontSize="11.5"
                       Text="Комнаты с шифрованием WireGuard, приоритет прямого соединения, резервный relay. Требуется настроенный контрольный сервер." />

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ══════════════ Toasts ══════════════ -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,320,24" IsHitTestVisible="True">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="services:Toast">
          <Border Classes="card" Width="330" Margin="0,6,0,0" Padding="14">
            <Grid ColumnDefinitions="4,*,Auto">
              <Border Background="{Binding Accent}" CornerRadius="2" Width="4" />
              <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" MaxLines="3" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Padding="4" VerticalAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissToastCommand}"
                      CommandParameter="{Binding}">
                <Path Data="{StaticResource IconClose}" Classes="icon" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ══════════════ Глобальный поиск (overlay) ══════════════ -->
    <Border Grid.Row="1" IsVisible="{Binding IsSearchOpen}" Background="#B3000000">
      <Border Classes="card" Width="560" VerticalAlignment="Top" Margin="0,120,0,0" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Глобальный поиск" Classes="h3" />
          <TextBox Classes="ehot" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Название мода, сборки, шейдера…"
                   AcceptsReturn="False" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding ToggleSearchCommand}" Content="Отмена" />
            <Button Classes="primary" Command="{Binding SubmitSearchCommand}" Content="Искать" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
