<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:conv2="using:EHOT.Launcher.UI.Converters"
        xmlns:conv="using:EHOT.Launcher.UI.Converters"
        xmlns:services="using:EHOT.Launcher.UI.Services"
        x:Class="EHOT.Launcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EHOT Launcher"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Mica, Blur, None">

  <Window.Resources>
    <conv:IconKeyConverter x:Key="IconKey" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:ToastKindBrushConverter x:Key="ToastBrush" />
    <conv:SelectedBackgroundConverter x:Key="SelectedBackground" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- ══════════════ Titlebar ══════════════ -->
    <Grid Grid.Row="0" Height="48" Background="#0E1119" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
        <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource AccentGradient}">
          <TextBlock Text="E" FontSize="13" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="EHOT Launcher" FontSize="12.5" FontWeight="SemiBold" LetterSpacing="0.2"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        <Border Classes="chip" Padding="8,2" VerticalAlignment="Center" Background="#1A8B5CF6">
          <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
        </Border>
      </StackPanel>

      <!-- Перетаскивание окна -->
      <Border Grid.Column="1" Background="Transparent" PointerPressed="OnTitleBarPressed" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="2">
        <Button Classes="icon" Width="34" Height="30" Click="OnMinimizeClick" ToolTip.Tip="Свернуть">
          <Path Data="{StaticResource IconMinimize}" Classes="icon" Width="13" Height="13" />
        </Button>
        <Button Classes="icon" Width="34" Height="30" Click="OnMaximizeClick" ToolTip.Tip="Развернуть">
          <Path Data="{StaticResource IconMaximize}" Classes="icon" Width="11" Height="11" />
        </Button>
        <Button Classes="icon" Width="34" Height="30" Click="OnCloseClick" ToolTip.Tip="Закрыть">
          <Path Data="{StaticResource IconClose}" Classes="icon" Width="12" Height="12" />
          <Button.Styles>
            <Style Selector="Button:pointerover /template/ Border#Root">
              <Setter Property="Background" Value="#C4484E" />
            </Style>
            <Style Selector="Button:pointerover Path">
              <Setter Property="Stroke" Value="#FFFFFF" />
            </Style>
          </Button.Styles>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══════════════ Основная область ══════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="236,*,300">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="#141824" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <StackPanel Grid.Row="0" Margin="16,18,16,10" Spacing="12">
            <Button Command="{Binding ToggleSearchCommand}" Classes="ghost"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="11,8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="{StaticResource IconSearch}" Classes="icon" />
                <TextBlock Grid.Column="1" Text="Поиск по каталогу" Margin="9,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="chip" Padding="6,1">
                  <TextBlock Text="⌘K" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,4,10,0">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                  <Button Classes="ghost" Command="{Binding SelectCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="0" Background="Transparent" BorderThickness="0">
                    <Border CornerRadius="10" Padding="11,8" Margin="0,1"
                            Background="{Binding IsSelected, Converter={StaticResource SelectedBackground}}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}" Classes="icon"
                              Width="16" Height="16"
                              Stroke="{Binding IsSelected, Converter={StaticResource SelectedBackground}, ConverterParameter=text}"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="11,0,0,0" FontSize="12.5"
                                   Foreground="{Binding IsSelected, Converter={StaticResource SelectedBackground}, ConverterParameter=text}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3"
                                Background="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"
                                IsVisible="{Binding IsSelected}" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Аккаунт внизу сайдбара -->
          <Border Grid.Row="2" Margin="12" Padding="12" CornerRadius="14" Background="#141926"
                  BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
            <Button Command="{Binding OpenProfileCommand}" Background="Transparent" BorderThickness="0"
                    Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}">
                  <TextBlock Text="{Binding AccountInitials}" FontWeight="Bold" FontSize="14"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding AccountKindLabel}" FontSize="10.5"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Button>
          </Border>
        </Grid>
      </Border>

      <!-- Контент -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="26,18,26,8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding CurrentPage.ErrorMessage, FallbackValue=''}" Classes="caption"
                       Foreground="{StaticResource DangerBrush}" IsVisible="{Binding CurrentPage.HasError}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding OpenNotificationsCommand}" ToolTip.Tip="Уведомления">
              <Path Data="{StaticResource IconBell}" Classes="icon" />
            </Button>
            <Border Classes="chip" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NetworkIndicator}" FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <!-- ══════ Обновление лаунчера: показывается только когда есть что обновлять ══════ -->
          <Border Grid.Row="0" IsVisible="{Binding Updates.IsVisible}" Margin="26,0,26,10"
                  CornerRadius="12" Padding="14,11" Background="#141B2B" BorderBrush="#2A3350" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}"
                      VerticalAlignment="Center">
                <Path Data="{StaticResource IconDownload}" Classes="icon" />
              </Border>

              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           Text="{Binding Updates.StatusText}" TextWrapping="Wrap" />
                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding Updates.ReleaseNotes}" TextWrapping="Wrap" MaxLines="2"
                           IsVisible="{Binding Updates.ReleaseNotes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock FontSize="10.5" Foreground="{StaticResource DangerBrush}"
                           Text="{Binding Updates.ErrorText}" TextWrapping="Wrap"
                           IsVisible="{Binding Updates.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ProgressBar Value="{Binding Updates.Progress}" Maximum="1" Height="4" Margin="0,3,0,0"
                             IsVisible="{Binding Updates.IsDownloading}" Foreground="{StaticResource AccentBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button Classes="primary" Content="Скачать" Command="{Binding Updates.DownloadCommand}"
                        IsVisible="{Binding Updates.HasUpdate}" />
                <Button Classes="primary" Content="Установить и перезапустить"
                        Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.IsReady}" />
                <Button Classes="ghost" Content="Страница релиза" Command="{Binding Updates.OpenReleasePageCommand}" />
                <Button Classes="icon" Content="✕" Command="{Binding Updates.DismissCommand}" ToolTip.Tip="Скрыть" />
              </StackPanel>
            </Grid>
          </Border>

          <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="26,0,26,18" />
        </Grid>
      </Grid>

      <!-- Правая колонка: контекст -->
      <Border Grid.Column="2" Background="#0E1119" BorderBrush="#141824" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,20" Spacing="14">

            <TextBlock Text="ТЕКУЩИЙ ПРОФИЛЬ" Classes="eyebrow" />

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding ProfileName}" Classes="h3" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProfileVersion}" Classes="caption" />
                <Border Classes="divider" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="Платформа" Classes="caption" />
                  <TextBlock Grid.Column="1" Text="{Binding PlatformLabel}" Classes="caption"
                             HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                  <TextBlock Grid.Row="1" Text="Аккаунт" Classes="caption" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccountName}" Classes="caption" Margin="0,4,0,0"
                             HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Classes="eyebrow" Margin="0,8,0,0" />

            <StackPanel Spacing="8">
              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding NavigateCommand}" CommandParameter="play">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Data="{StaticResource IconPlay}" Classes="icon" Width="15" Height="15" />
                  <TextBlock Text="Профили и запуск" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding NavigateCommand}" CommandParameter="versions">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Data="{StaticResource IconLayers}" Classes="icon" Width="15" Height="15" />
                  <TextBlock Text="Установить версию" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding NavigateCommand}" CommandParameter="accounts">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Data="{StaticResource IconUser}" Classes="icon" Width="15" Height="15" />
                  <TextBlock Text="Аккаунт и вход" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="6" IsVisible="{Binding IsAccountSelected}">
              <TextBlock Text="КАК Я ЗАХОЖУ В ИГРУ" Classes="eyebrow" />
              <Border CornerRadius="12" Padding="12" Background="#101724">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#1E2740" ClipToBounds="True"
                            BorderBrush="#26314A" BorderThickness="1">
                      <Image Source="{Binding AccountSkinPath, Converter={x:Static conv2:SkinFaceConverter.Instance}}"
                             Width="34" Height="34" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding AccountSkinLabel}" Classes="caption" FontSize="10.5"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="divider" />
                  <TextBlock Text="{Binding AccountUuidSource}" Classes="caption" FontSize="10.5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AccountUuid}" FontSize="9.5" TextWrapping="Wrap" FontFamily="monospace"
                             Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ══════════════ Toasts ══════════════ -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,320,24" IsHitTestVisible="True">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="services:Toast">
          <Border Classes="card" Width="330" Margin="0,6,0,0" Padding="14">
            <Grid ColumnDefinitions="4,*,Auto">
              <Border Background="{Binding Accent}" CornerRadius="2" Width="4" />
              <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" MaxLines="3" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Padding="4" VerticalAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissToastCommand}"
                      CommandParameter="{Binding}">
                <Path Data="{StaticResource IconClose}" Classes="icon" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ══════════════ Глобальный поиск (overlay) ══════════════ -->
    <Border Grid.Row="1" IsVisible="{Binding IsSearchOpen}" Background="#B3000000">
      <Border Classes="card" Width="560" VerticalAlignment="Top" Margin="0,120,0,0" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Глобальный поиск" Classes="h3" />
          <TextBox Classes="ehot" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Название мода, сборки, шейдера…"
                   AcceptsReturn="False" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding ToggleSearchCommand}" Content="Отмена" />
            <Button Classes="primary" Command="{Binding SubmitSearchCommand}" Content="Искать" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
