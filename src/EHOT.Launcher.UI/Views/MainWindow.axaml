<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
        xmlns:conv2="using:EHOT.Launcher.UI.Converters"
        xmlns:conv="using:EHOT.Launcher.UI.Converters"
        xmlns:services="using:EHOT.Launcher.UI.Services"
        x:Class="EHOT.Launcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EHOT Launcher"
        Width="1320" Height="800"
        MinWidth="1040" MinHeight="680"
        Background="{StaticResource BackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="None"
        Icon="avares://EHOT.Launcher/Assets/ehot.ico"
        Loaded="OnLoaded">

  <Window.Resources>
    <conv:IconKeyConverter x:Key="IconKey" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:ToastKindBrushConverter x:Key="ToastBrush" />
    <conv:SelectedBackgroundConverter x:Key="SelectedBackground" />
  </Window.Resources>

  <Grid Name="RootGrid" RowDefinitions="Auto,*" Classes="window-load">

    <!-- ══════════════ Titlebar ══════════════ -->
    <Grid Grid.Row="0" Height="46" Background="{StaticResource GlassTitleBarBrush}" ColumnDefinitions="Auto,*,Auto" Panel.ZIndex="10">
      <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding NavigateCommand}" CommandParameter="home" ToolTip.Tip="На главный экран" Padding="0" Background="Transparent" BorderThickness="0">
          <Image Source="avares://EHOT.Launcher/Assets/ehot-logo-orange.png" Width="26" Height="26" Stretch="UniformToFill">
            <Image.Clip>
              <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0 0 26 26" />
            </Image.Clip>
          </Image>
        </Button>
        <TextBlock Text="EHOT Launcher" FontSize="13" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <Border Grid.Column="1" Background="Transparent" PointerPressed="OnTitleBarPressed" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,8,0" Spacing="0">
        <Button Classes="window" Click="OnMinimizeClick" ToolTip.Tip="Свернуть">
          <Path Data="{StaticResource IconWinMinimize}" />
        </Button>
        <Button Classes="window" Click="OnMaximizeClick" ToolTip.Tip="Развернуть во весь экран">
          <Path Data="{StaticResource IconWinMaximize}" x:Name="MaxGlyph" />
        </Button>
        <Button Classes="window close" Click="OnCloseClick" ToolTip.Tip="Закрыть">
          <Path Data="{StaticResource IconWinClose}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══════════════ Основная область ══════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="226,*">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource GlassSidebarBrush}" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <StackPanel Grid.Row="0" Margin="12,14,12,8" Spacing="2">
            <Button Command="{Binding ToggleSearchCommand}" Classes="ghost"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="11,8" Background="{StaticResource GlassCardBrush}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="{StaticResource IconSearch}" Classes="icon" Width="15" Height="15" />
                <TextBlock Grid.Column="1" Text="Поиск в каталоге" Margin="9,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="chip" Padding="6,1">
                  <TextBlock Text="⌘K" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,6,10,0">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                  <Button Command="{Binding SelectCommand}" Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0">
                    <Border CornerRadius="12" Padding="12,10"
                            Background="{Binding IsSelected, Converter={StaticResource SelectedBackground}}"
                            BorderBrush="{Binding IsSelected, Converter={StaticResource SelectedBackground}, ConverterParameter=border}"
                            BorderThickness="1">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}" Classes="icon"
                              Width="17" Height="17"
                              Stroke="{Binding IsSelected, Converter={StaticResource SelectedBackground}, ConverterParameter=text}"
                              VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{Binding IsSelected, Converter={StaticResource SelectedBackground}, ConverterParameter=text}" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3"
                                Background="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                IsVisible="{Binding IsSelected}" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Аккаунт внизу рельса -->
          <Border Grid.Row="2" Margin="12" Padding="10" CornerRadius="14" Background="{StaticResource GlassCardBrush}"
                  BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
            <Button Command="{Binding OpenProfileCommand}" Background="Transparent" BorderThickness="0"
                    Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="36" Height="36" CornerRadius="10" Background="#332A24" ClipToBounds="True" BorderBrush="#3A322B" BorderThickness="1">
                  <Panel>
                    <TextBlock Text="{Binding AccountInitials}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource AccentHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding AccountSkinPath, Converter={x:Static ObjectConverters.IsNull}}" />
                    <Image Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"
                           IsVisible="{Binding AccountSkinPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Source="{Binding AccountSkinPath, Converter={x:Static conv2:SkinFaceConverter.Instance}}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding AccountKindLabel}" FontSize="10.5"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Classes="icon" Width="14" Height="14"
                      VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Border>
        </Grid>
      </Border>

      <!-- Контент -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{StaticResource BackgroundBrush}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,12,24,6">
          <TextBlock Text="{Binding CurrentPage.ErrorMessage, FallbackValue=''}" Classes="caption"
                     Foreground="{StaticResource DangerBrush}" IsVisible="{Binding CurrentPage.HasError}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding OpenNotificationsCommand}" ToolTip.Tip="Уведомления">
              <Path Data="{StaticResource IconBell}" Classes="icon" />
            </Button>
            <Button Classes="icon" Command="{Binding OpenDownloadsCommand}" ToolTip.Tip="Очередь загрузок">
              <Path Data="{StaticResource IconDownload}" Classes="icon" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <!-- Обновление лаунчера: только когда есть что обновлять -->
          <Border Grid.Row="0" IsVisible="{Binding Updates.IsVisible}" Margin="24,0,24,10"
                  CornerRadius="12" Padding="14,11" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                <Path Data="{StaticResource IconDownload}" Classes="icon" Stroke="White" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           Text="{Binding Updates.StatusText}" TextWrapping="Wrap" />
                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding Updates.ReleaseNotes}" TextWrapping="Wrap" MaxLines="2"
                           IsVisible="{Binding Updates.ReleaseNotes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ProgressBar Value="{Binding Updates.Progress}" Maximum="1" Height="4" Margin="0,3,0,0"
                             IsVisible="{Binding Updates.IsDownloading}" Foreground="{StaticResource AccentBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button Classes="primary" Content="Скачать" Command="{Binding Updates.DownloadCommand}" IsVisible="{Binding Updates.HasUpdate}" />
                <Button Classes="primary" Content="Установить и перезапустить" Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.IsReady}" />
                <Button Classes="icon" Command="{Binding Updates.DismissCommand}" ToolTip.Tip="Скрыть">
                  <Path Data="{StaticResource IconClose}" Classes="icon" Width="12" Height="12" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24,0,24,20">
            <ContentControl.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.20" />
              </Transitions>
            </ContentControl.Transitions>
          </ContentControl>
        </Grid>
      </Grid>
    </Grid>

    <!-- ══════════════ Toasts ══════════════ -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                  VerticalAlignment="Bottom" Margin="0,0,24,24" IsHitTestVisible="True">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="services:Toast">
          <Border Classes="card" Width="340" Margin="0,6,0,0" Padding="14">
            <Grid ColumnDefinitions="4,*,Auto">
              <Border Background="{Binding Accent}" CornerRadius="2" Width="4" />
              <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" MaxLines="3" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Padding="4" VerticalAlignment="Top"
                      Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissToastCommand}"
                      CommandParameter="{Binding}">
                <Path Data="{StaticResource IconClose}" Classes="icon" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ══════════════ Глобальный поиск ══════════════ -->
    <Border Grid.Row="1" IsVisible="{Binding IsSearchOpen}" Background="#B8111216" ZIndex="20">
      <Border Classes="card glass-card" Width="620" VerticalAlignment="Top" Margin="0,92,0,0" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Поиск в каталоге Modrinth" Classes="h3" />
          <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Название мода, сборки, текстуры или шейдера…" AcceptsReturn="False" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding ToggleSearchCommand}" Content="Отмена" />
            <Button Classes="primary" Command="{Binding SubmitSearchCommand}" Content="Найти" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
