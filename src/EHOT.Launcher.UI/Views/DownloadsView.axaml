<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:dl="using:EHOT.Launcher.Core.Downloads"
             x:Class="EHOT.Launcher.UI.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">

    <!-- ══════ Заголовок ══════ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Загрузки" Classes="h1" />
        <TextBlock Text="{Binding Summary}" Classes="body" />
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost" Command="{Binding LoadHistoryCommand}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="{StaticResource IconRefresh}" Classes="icon" Width="15" Height="15" />
          <TextBlock Text="Обновить историю" FontSize="12.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- ══════ Текущая активность ══════ -->
    <Border Grid.Row="1" CornerRadius="18" Padding="20,16" Background="#141A26"
            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Width="40" Height="40" CornerRadius="12" Background="#1E2740" VerticalAlignment="Center">
          <Path Data="{StaticResource IconDownload}" Classes="icon blue" Width="18" Height="18"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource TextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <ProgressBar Classes="ehot" Height="5" IsIndeterminate="{Binding IsBusy}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="История хранится локально" Classes="caption" FontSize="10.5"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ══════ Очередь и история ══════ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">

      <Border CornerRadius="18" Padding="20,16" Background="#141A26"
              BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="0,0,0,10">
            <TextBlock Text="Очередь" Classes="h3" VerticalAlignment="Center" />
            <Border Classes="chip" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Active.Count, StringFormat='{}{0}'}" FontSize="10"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="1">
            <Grid>
              <ItemsControl ItemsSource="{Binding Active}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dl:DownloadSnapshot">
                    <Border CornerRadius="12" Padding="13,11" Margin="0,0,0,7" Background="#171E2C"
                            BorderBrush="#1E2739" BorderThickness="1">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding State}" Classes="caption" FontSize="10.5"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Classes="ehot" Height="5" Value="{Binding Fraction}" Maximum="1" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding BytesPerSecond, Converter={x:Static vm:NetConverters.Speed}}"
                                     Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="icon" ToolTip.Tip="Пауза"
                                    Command="{Binding $parent[ItemsControl].((vm:DownloadsViewModel)DataContext).PauseCommand}"
                                    CommandParameter="{Binding}">
                              <Path Data="{StaticResource IconPause}" Classes="icon" Width="12" Height="12" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="Отменить"
                                    Command="{Binding $parent[ItemsControl].((vm:DownloadsViewModel)DataContext).CancelCommand}"
                                    CommandParameter="{Binding}">
                              <Path Data="{StaticResource IconClose}" Classes="icon" Width="12" Height="12" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsVisible="{Binding !Active.Count}">
                <TextBlock Text="Очередь пуста" Classes="h3" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                           Text="Установка версии, мода или сборки появится здесь: прогресс, скорость и отмена." />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="1" CornerRadius="18" Padding="20,16" Background="#141A26"
              BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" Margin="0,0,0,10">
            <TextBlock Text="История" Classes="h3" VerticalAlignment="Center" />
            <Border Classes="chip" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding History.Count, StringFormat='{}{0}'}" FontSize="10"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="1">
            <Grid>
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dl:DownloadHistoryEntry">
                    <Border CornerRadius="10" Padding="12,9" Margin="0,0,0,6" Background="#171E2C">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CompletedAt, Converter={x:Static vm:TextConverters.ShortDate}}"
                                   Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsVisible="{Binding !History.Count}">
                <TextBlock Text="Пока ничего не скачано" Classes="h3" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="260" TextWrapping="Wrap"
                           Text="Здесь появятся завершённые загрузки с датой и временем." />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
