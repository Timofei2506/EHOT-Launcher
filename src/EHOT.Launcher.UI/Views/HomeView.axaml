<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:conv="using:EHOT.Launcher.UI.Converters"
             xmlns:models="using:EHOT.Launcher.Core.Models"
             x:Class="EHOT.Launcher.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <UserControl.Resources>
    <conv:BytesToHumanConverter x:Key="Bytes" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18" Margin="0,0,6,0">

      <!-- ═══ Hero: профиль + ИГРАТЬ ═══ -->
      <Border Classes="hero">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

          <!-- Левая часть: профиль -->
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Greeting}" Classes="eyebrow" />
              <TextBlock Text="·" Classes="eyebrow" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding AccountKindLabel}" Classes="eyebrow"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding ProfileName}" FontSize="34" FontWeight="Bold" LetterSpacing="-0.6"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding ProfileVersion}" FontSize="13.5"
                       Foreground="{StaticResource AccentBlueBrush}" />
          </StackPanel>

          <!-- Кнопка ИГРАТЬ справа, всегда одной ширины -->
          <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primary" Width="208" Height="60" CornerRadius="18"
                    Command="{Binding PlayCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform" Width="18" Height="18" />
                <TextBlock Text="{Binding PlayButtonText}" FontSize="18" FontWeight="Bold" LetterSpacing="1.2"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding InstallStatus}" Classes="caption" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="208" />
          </StackPanel>

          <!-- Нижняя строка: три показателя + предупреждение -->
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,22,0,0" ColumnDefinitions="*,*,*" ColumnSpacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="УСТАНОВКА" Classes="caption" FontSize="9.5" LetterSpacing="1.1" />
              <ProgressBar Classes="ehot" Height="5" Value="{Binding InstallProgress}" Maximum="1" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="ПОСЛЕДНИЙ ЗАПУСК" Classes="caption" FontSize="9.5" LetterSpacing="1.1" />
              <TextBlock Text="{Binding LastLaunchLabel}" FontSize="12" Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="СЕТЬ" Classes="caption" FontSize="9.5" LetterSpacing="1.1" />
              <TextBlock Text="{Binding NetworkStatus}" FontSize="12" Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="12,10" CornerRadius="12"
                  Background="#1AFBBF24" IsVisible="{Binding HasCapabilityWarning}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Data="{StaticResource IconWarning}" Classes="icon" Stroke="{StaticResource WarningBrush}"
                    Width="15" Height="15" VerticalAlignment="Top" />
              <TextBlock Text="{Binding CapabilityWarning}" FontSize="11.5" TextWrapping="Wrap"
                         Foreground="{StaticResource WarningBrush}" MaxWidth="760" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ═══ Быстрые действия ═══ -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Border Classes="card" Padding="16" Cursor="Hand">
          <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch"
                  Command="{Binding OpenContentCommand}" CommandParameter="mods">
            <StackPanel Spacing="8">
              <Border Width="34" Height="34" CornerRadius="10" Background="#1A8B5CF6" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconPuzzle}" Classes="icon" Stroke="{StaticResource AccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Моды" Classes="h3" />
              <TextBlock Text="Каталог Modrinth" Classes="caption" TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
          </Button>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="16">
          <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch"
                  Command="{Binding OpenContentCommand}" CommandParameter="modpacks">
            <StackPanel Spacing="8">
              <Border Width="34" Height="34" CornerRadius="10" Background="#1A38BDF8" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconBox}" Classes="icon blue"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Сборки" Classes="h3" />
              <TextBlock Text="Готовые модпаки" Classes="caption" TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
          </Button>
        </Border>

        <Border Grid.Column="2" Classes="card" Padding="16">
          <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch"
                  Command="{Binding OpenNetworkCommand}">
            <StackPanel Spacing="8">
              <Border Width="34" Height="34" CornerRadius="10" Background="#1A34D399" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconNetwork}" Classes="icon" Stroke="{StaticResource SuccessBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Играть вместе" Classes="h3" />
              <TextBlock Text="{Binding NetworkDetail}" Classes="caption" TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
          </Button>
        </Border>

        <Border Grid.Column="3" Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <Border Width="34" Height="34" CornerRadius="10" Background="#1AFBBF24" HorizontalAlignment="Left">
              <Path Data="{StaticResource IconFolder}" Classes="icon" Stroke="{StaticResource WarningBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Каталог игры" Classes="h3" />
            <TextBlock Text="{Binding MinecraftRoot}" Classes="caption" TextWrapping="Wrap" MaxLines="2" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ═══ Новости ═══ -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Новости Minecraft" Classes="h2" />
        <TextBlock Grid.Column="1" Text="официальный источник Mojang" Classes="caption" VerticalAlignment="Center" />
      </Grid>

      <Border CornerRadius="14" Padding="16" Background="#141A26"
              BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
              IsVisible="{Binding News.Count, Converter={x:Static vm:TextConverters.IsZero}}">
        <TextBlock Text="Новости не загрузились: источник Mojang не ответил при запуске." Classes="caption"
                   TextWrapping="Wrap" />
      </Border>

      <ItemsControl ItemsSource="{Binding News}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NewsCardViewModel">
            <Border CornerRadius="14" Margin="0,0,12,0" Padding="16" Background="#141A26"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <Border Height="92" CornerRadius="12" Background="#1A2233">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding Type}" Classes="eyebrow" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="{Binding DateLabel}" Classes="caption" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ═══ Популярные моды ═══ -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Популярные моды" Classes="h2" />
        <TextBlock Grid.Column="1" Text="по загрузкам Modrinth" Classes="caption" VerticalAlignment="Center" />
      </Grid>

      <Border CornerRadius="14" Padding="16" Background="#141A26"
              BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
              IsVisible="{Binding PopularMods.Count, Converter={x:Static vm:TextConverters.IsZero}}">
        <TextBlock Text="Каталог Modrinth не ответил — популярные моды появятся после загрузки." Classes="caption"
                   TextWrapping="Wrap" />
      </Border>

      <ItemsControl ItemsSource="{Binding PopularMods}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ContentCardViewModel">
            <Border CornerRadius="14" Margin="0,0,10,10" Padding="14" Background="#141A26"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="38" Height="38" CornerRadius="10" Background="#1A8B5CF6">
                    <TextBlock Text="{Binding Title, Converter={x:Static vm:TextConverters.FirstLetter}}"
                               FontWeight="Bold" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Author}" Classes="caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Description}" Classes="caption" MaxLines="2" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding DownloadsLabel}" Classes="caption" Foreground="{StaticResource AccentBlueBrush}" />
                  <TextBlock Text="{Binding CategoriesLabel}" Classes="caption" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ═══ Популярные сборки + недавние запуски ═══ -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Популярные сборки" Classes="h2" />
          <Border CornerRadius="14" Padding="14" Background="#141A26"
                  BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                  IsVisible="{Binding PopularModpacks.Count, Converter={x:Static vm:TextConverters.IsZero}}">
            <TextBlock Text="Сборки не загрузились: каталог недоступен." Classes="caption" TextWrapping="Wrap" />
          </Border>
          <ItemsControl ItemsSource="{Binding PopularModpacks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContentCardViewModel">
                <Border CornerRadius="12" Margin="0,0,0,8" Padding="12" Background="#141A26"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#1A38BDF8">
                      <Path Data="{StaticResource IconBox}" Classes="icon blue" Width="15" Height="15"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Description}" Classes="caption" MaxLines="1"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DownloadsLabel}" Classes="caption"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Text="Недавние запуски" Classes="h2" />
          <ItemsControl ItemsSource="{Binding RecentLaunches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:LaunchRecord">
                <Border CornerRadius="12" Margin="0,0,0,8" Padding="12" Background="#141A26"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding MinecraftVersion}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:dd.MM HH:mm}'}" Classes="caption" />
                      <TextBlock Text="{Binding Status}" Classes="caption" Foreground="{StaticResource AccentBlueBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border CornerRadius="14" Padding="14" Background="#141A26"
                  BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                  IsVisible="{Binding RecentLaunches.Count, Converter={x:Static vm:TextConverters.IsZero}}">
            <TextBlock Text="Пока нет истории запусков — самое время начать." Classes="caption" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
