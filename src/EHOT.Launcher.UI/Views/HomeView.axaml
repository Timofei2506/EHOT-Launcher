<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:controls="using:EHOT.Launcher.UI.Controls"
             xmlns:conv="using:EHOT.Launcher.UI.Converters"
             x:Class="EHOT.Launcher.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Grid>
    <!-- Фон главного экрана -->
    <Image Source="avares://EHOT.Launcher/Assets/home-bg.jpg" Stretch="UniformToFill" Opacity="0.46" />
    <Border Background="#B8111216" />

    <Grid RowDefinitions="*,Auto" Margin="8,4,8,0">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="28">

        <!-- Левая часть: приветствие и запуск -->
        <StackPanel Spacing="18" VerticalAlignment="Center" MaxWidth="720">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Greeting}" FontSize="38" FontWeight="Bold" LetterSpacing="-0.8"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding Hint}" Classes="body" FontSize="14" />
          </StackPanel>

          <!-- Версия + канал -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaxWidth="640">
            <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                      Width="132" ToolTip.Tip="Тип версий" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      PlaceholderText="Версия Minecraft">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VersionChoice">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Classes="caption" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- Загрузчики -->
          <ItemsControl ItemsSource="{Binding LoaderOptions}" MaxWidth="640">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LoaderOption">
                  <Button Classes="pill" Margin="0,0,8,8" Padding="14,7"
                          IsEnabled="{Binding IsAvailable}"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).SelectLoaderCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Hint}">
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Кнопка запуска -->
          <Button Classes="primary" Width="420" Height="58" CornerRadius="16" HorizontalAlignment="Left"
                  Command="{Binding PlayCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Path Data="{StaticResource IconPlay}" Fill="White" Width="18" Height="18" Stretch="Uniform" />
              <TextBlock Text="{Binding PlayButtonText}" FontSize="19" FontWeight="Bold" LetterSpacing="0.2" />
            </StackPanel>
          </Button>

          <StackPanel Spacing="6" MaxWidth="560">
            <TextBlock Text="{Binding InstallStatus}" Classes="caption" />
            <ProgressBar Classes="ehot" Height="6" IsIndeterminate="{Binding IsInstalling}"
                         Value="{Binding InstallProgress}" Maximum="1" />
            <TextBlock Text="{Binding LastLaunchLabel}" Classes="caption" FontSize="10.5" />
          </StackPanel>
        </StackPanel>

        <!-- Правая часть: персонаж -->
        <Grid Grid.Column="1" Width="300" VerticalAlignment="Center">
          <Border CornerRadius="22" Background="#26191116" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <Panel Width="220" Height="285">
                <Border CornerRadius="18" Background="#1A111216" IsVisible="{Binding SkinPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <controls:Skin3DView SkinPath="{Binding SkinPath}" Margin="2" />
                </Border>
                <StackPanel IsVisible="{Binding SkinPath, Converter={x:Static ObjectConverters.IsNull}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                  <Image Source="avares://EHOT.Launcher/Assets/mascot-raccoon.png" Width="150" Height="150" Stretch="Uniform" />
                  <TextBlock Text="Скин не загружен" Classes="caption" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <TextBlock Text="{Binding AccountName}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                         Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
              <TextBlock Text="{Binding AccountKindLabel}" Classes="caption" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Нижняя карточка «что нового» -->
      <Border Grid.Row="1" Margin="0,10,0,10" CornerRadius="16" Padding="14,12"
              Background="#CC1B1B22" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Image Source="avares://EHOT.Launcher/Assets/ehot-logo-orange.png" Width="42" Height="42" Stretch="UniformToFill" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding WhatsNewTitle}" Classes="h3" />
            <TextBlock Text="{Binding WhatsNewSummary}" Classes="caption" MaxLines="1" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" Command="{Binding OpenNewsCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Подробнее" FontSize="12.5" VerticalAlignment="Center" />
              <Path Data="{StaticResource IconChevronRight}" Classes="icon" Width="12" Height="12" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Сплэш запуска: реальные стадии, без выдуманного процента -->
    <Grid IsVisible="{Binding IsBusy}" Background="#D9111216">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <Image Source="avares://EHOT.Launcher/Assets/mascot-raccoon.png" Width="220" Height="220" Stretch="Uniform" />
        <TextBlock Text="Запуск Minecraft…" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding InstallStatus}" Classes="caption" HorizontalAlignment="Center" MaxWidth="520" TextWrapping="Wrap" TextAlignment="Center" />
        <ProgressBar Classes="ehot" Width="420" Height="8" Value="{Binding InstallProgress}" Maximum="1" />
        <Border Classes="chip" Padding="14,8" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="{StaticResource IconSparkle}" Classes="icon" Stroke="{StaticResource AccentHotBrush}" Width="14" Height="14" />
            <TextBlock Text="Совет: OptiFine или Iris помогут поднять FPS в тяжёлых мирах." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
