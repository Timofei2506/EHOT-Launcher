<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:conv="using:EHOT.Launcher.UI.Converters"
             x:Class="EHOT.Launcher.UI.Views.ServersView"
             x:DataType="vm:ServersViewModel">

  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Серверы" Classes="h1" />
          <TextBlock Text="Ваши серверы: реальный пинг, игроки и версия по Java Server List Ping" Classes="body" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Command="{Binding PingAllCommand}" VerticalAlignment="Center" ToolTip.Tip="Опросить все серверы">
          <Path Data="{StaticResource IconRefresh}" Classes="icon" />
        </Button>
        <Button Grid.Column="2" Classes="primary" Command="{Binding OpenAddEditorCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconPlus}" Classes="icon" Stroke="White" Width="13" Height="13" />
            <TextBlock Text="Добавить сервер" FontSize="12.5" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="pill" Command="{Binding SetTabCommand}" CommandParameter="Мои серверы" Content="Мои серверы" />
          <Button Classes="pill" Command="{Binding SetTabCommand}" CommandParameter="Избранные" Content="Избранные" />
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Поиск по названию, адресу или описанию…"
                 HorizontalAlignment="Right" Width="320" />
      </Grid>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <Grid>
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerViewItem">
                <Border Classes="card" Margin="0,0,0,12" Padding="14">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="14">
                    <!-- Аватар-кубик сервера -->
                    <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="Bold" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Classes="chip" Padding="8,2" Margin="10,0,0,0">
                          <TextBlock Text="{Binding StatusDetail}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Address}" Classes="caption" />
                      <TextBlock Text="{Binding Description}" Classes="caption" TextTrimming="CharacterEllipsis" IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding ServerMotd}" Classes="caption" TextTrimming="CharacterEllipsis" IsVisible="{Binding ServerMotd, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding IsOnline, Converter={x:Static conv:BoolToOnlineBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).CopyAddressCommand}" CommandParameter="{Binding}" ToolTip.Tip="Копировать адрес">
                      <Path Data="{StaticResource IconCopy}" Classes="icon" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}" ToolTip.Tip="Избранное">
                      <Path Data="{StaticResource IconStar}" Classes="icon" />
                    </Button>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="ghost" Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).PingOneCommand}" CommandParameter="{Binding}">
                        <TextBlock Text="Обновить" FontSize="11.5" />
                      </Button>
                      <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).OpenEditEditorCommand}" CommandParameter="{Binding}" ToolTip.Tip="Редактировать">
                        <Path Data="{StaticResource IconSettings}" Classes="icon" Width="14" Height="14" />
                      </Button>
                      <Button Classes="icon" Command="{Binding $parent[ItemsControl].((vm:ServersViewModel)DataContext).AskDeleteCommand}" CommandParameter="{Binding}" ToolTip.Tip="Удалить">
                        <Path Data="{StaticResource IconTrash}" Classes="icon" Width="14" Height="14" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding !HasItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <Image Source="avares://EHOT.Launcher/Assets/mascot-raccoon.png" Width="150" Height="150" Stretch="Uniform" />
            <TextBlock Text="Серверов пока нет" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Добавьте любой Java-сервер — лаунчер честно покажет онлайн, игроков и версию." Classes="caption" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Редактор -->
    <Border IsVisible="{Binding IsEditorOpen}" Background="#B8111216" ZIndex="20">
      <Border Classes="card glass-card" Width="520" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Сервер" Classes="h3" />
          <TextBox Text="{Binding EditorName, Mode=TwoWay}" PlaceholderText="Название" />
          <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
            <TextBox Text="{Binding EditorHost, Mode=TwoWay}" PlaceholderText="Адрес (host)" />
            <TextBox Grid.Column="1" Text="{Binding EditorPort, Mode=TwoWay}" PlaceholderText="Порт" />
          </Grid>
          <TextBox Text="{Binding EditorDescription, Mode=TwoWay}" PlaceholderText="Заметка (необязательно)" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding CloseEditorCommand}" Content="Отмена" />
            <Button Classes="primary" Command="{Binding SaveEditorCommand}" Content="Сохранить" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Подтверждение удаления -->
    <Border IsVisible="{Binding ItemPendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#CC111216" ZIndex="30">
      <Border Classes="card glass-card" Width="460" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Удалить сервер?" Classes="h3" />
          <TextBlock Text="{Binding ItemPendingDelete.Address}" Classes="caption" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding CancelDeleteCommand}" Content="Отмена" />
            <Button Classes="danger" Command="{Binding ConfirmDeleteCommand}" Content="Удалить" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
