<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:net="using:EHOT.Launcher.Network"
             x:Class="EHOT.Launcher.UI.Views.GameNetworkView"
             x:DataType="vm:GameNetworkViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="14">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="EHOT Game Network" Classes="h1" />
        <TextBlock Text="Виртуальная локальная сеть для совместной игры: WireGuard, STUN, relay" Classes="body" />
      </StackPanel>
      <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                   Fill="{Binding IsConnected, Converter={x:Static vm:NetConverters.StatusBrush}}" />
          <TextBlock Text="{Binding StateLabel}" FontSize="11.5" Foreground="{StaticResource TextBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="360,*,320" ColumnSpacing="14">

      <!-- Создание / вход -->
      <StackPanel Spacing="12">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Создать комнату" Classes="h3" />
            <TextBox Classes="ehot" Text="{Binding RoomName, Mode=TwoWay}" PlaceholderText="Название комнаты" />
            <TextBox Classes="ehot" Text="{Binding DisplayName, Mode=TwoWay}" PlaceholderText="Ваше имя в комнате" />
            <Button Classes="primary" HorizontalAlignment="Stretch" Content="Создать"
                    Command="{Binding CreateRoomCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Подключиться по коду" Classes="h3" />
            <TextBox Classes="ehot" Text="{Binding JoinCode, Mode=TwoWay}" PlaceholderText="Код приглашения (8 символов)" />
            <Button Classes="ghost" HorizontalAlignment="Stretch" Content="Подключиться"
                    Command="{Binding JoinRoomCommand}" />
            <Button Classes="danger" HorizontalAlignment="Stretch" Content="Выйти из комнаты"
                    Command="{Binding LeaveCommand}" IsVisible="{Binding IsConnected}" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14">
          <StackPanel Spacing="6">
            <TextBlock Text="Сетевой туннель" Classes="h3" />
            <TextBlock Text="{Binding TunnelStatus}" Classes="caption" TextWrapping="Wrap" />
            <Border Classes="chip" HorizontalAlignment="Left" Margin="0,4,0,0">
              <TextBlock Text="{Binding TunnelAvailable, Converter={x:Static vm:NetConverters.TunnelLabel}}"
                         FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Участники и адрес -->
      <StackPanel Grid.Column="1" Spacing="12">
        <Border Classes="hero" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Адрес для Minecraft" Classes="eyebrow" />
            <TextBlock Text="{Binding MinecraftAddress}" Classes="display" FontSize="32" />
            <TextBlock Text="{Binding StateDetail}" Classes="caption" TextWrapping="Wrap" MaxWidth="520" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Classes="primary" Content="Скопировать адрес" Command="{Binding CopyAddressCommand}" />
              <Border Classes="chip" VerticalAlignment="Center">
                <TextBlock Text="{Binding InviteCode, StringFormat='Код: {0}'}" FontSize="11"
                           Foreground="{StaticResource TextBrush}" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="Участники" Classes="h3" />
              <TextBlock Grid.Column="1" Text="{Binding Peers.Count, StringFormat='{}{0}'}" Classes="caption" />
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="300">
              <ItemsControl ItemsSource="{Binding Peers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="net:RoomPeer">
                    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#1A8B5CF6">
                          <TextBlock Text="{Binding DisplayName, Converter={x:Static vm:TextConverters.FirstLetter}}"
                                     FontWeight="Bold" FontSize="12" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" />
                          <TextBlock Text="{Binding VirtualIp}" Classes="caption" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="chip" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Transport}" FontSize="10"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Удалить участника"
                                Command="{Binding $parent[ItemsControl].((vm:GameNetworkViewModel)DataContext).KickCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="{StaticResource IconTrash}" Classes="icon" Width="13" Height="13" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Диагностика -->
      <StackPanel Grid.Column="2" Spacing="12">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Соединение" Classes="h3" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
              <TextBlock Text="Транспорт" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{Binding TransportLabel}" Classes="caption"
                         Foreground="{StaticResource TextBrush}" />
              <TextBlock Grid.Row="1" Text="Задержка" Classes="caption" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatencyLabel}" Classes="caption"
                         Foreground="{StaticResource TextBrush}" />
              <TextBlock Grid.Row="2" Text="Трафик" Classes="caption" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TrafficLabel}" Classes="caption"
                         Foreground="{StaticResource TextBrush}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Безопасность" Classes="h3" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Трафик шифруется WireGuard (Curve25519 + ChaCha20-Poly1305). Сервер комнат видит только список участников и открытые ключи, но не игровой трафик. Маршрут добавляется только на подсеть комнаты — доступа к домашней сети и интернету нет." />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Приглашение можно отозвать в любой момент; удалённый участник теряет доступ немедленно." />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
