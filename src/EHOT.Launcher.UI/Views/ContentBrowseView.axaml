<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:content="using:EHOT.Launcher.Content.Models"
             xmlns:storage="using:EHOT.Launcher.Core.Models"
             x:Class="EHOT.Launcher.UI.Views.ContentBrowseView"
             x:DataType="vm:ContentBrowseViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{Binding Subtitle}" Classes="body" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="180" />
        <Button Classes="ghost" Content="Моё" Command="{Binding ToggleInstalledCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Classes="ehot" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="Поиск: название, описание, тег" />
      <Button Grid.Column="1" Classes="primary" MinWidth="110" Content="Найти"
              Command="{Binding SearchCommand}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,340" ColumnSpacing="14">

      <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="10">
      <Border Grid.Row="0" Padding="12" CornerRadius="12" Background="#1A38BDF8"
              IsVisible="{Binding HasProviderNotice}">
        <TextBlock Text="{Binding ProviderNotice}" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource AccentBlueBrush}" />
      </Border>
      <Grid Grid.Row="1">

      <!-- Результаты -->
      <Grid>
        <ScrollViewer IsVisible="{Binding ShowInstalled, Converter={x:Static BoolConverters.Not}}">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding TotalHits, StringFormat='Найдено: {0}'}" Classes="caption" />

            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="content:ContentProject">
                  <Border Classes="card" Margin="0,0,10,10" Padding="13">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#1A8B5CF6">
                          <TextBlock Text="{Binding Title, Converter={x:Static vm:TextConverters.FirstLetter}}"
                                     FontWeight="Bold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                     Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Author, FallbackValue='—'}" Classes="caption" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" MaxLines="3" />
                      <Button Classes="ghost" HorizontalAlignment="Stretch" FontSize="11" Padding="8,5" Content="Подробнее"
                              Command="{Binding $parent[ItemsControl].((vm:ContentBrowseViewModel)DataContext).OpenProjectCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="ghost" Content="Загрузить ещё" HorizontalAlignment="Center"
                    Command="{Binding LoadMoreCommand}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Установленное -->
        <ScrollViewer IsVisible="{Binding ShowInstalled}">
          <ItemsControl ItemsSource="{Binding InstalledItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="storage:InstalledContent">
                <Border Classes="card" Margin="0,0,0,8" Padding="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" FontSize="12.5"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding FileName}" Classes="caption" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="danger" Padding="10,4" FontSize="11" Content="Удалить"
                            Command="{Binding $parent[ItemsControl].((vm:ContentBrowseViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{Binding EmptyStateTitle}" Classes="h3" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      </Grid>
      </Grid>

      <!-- Детали проекта -->
      <Border Grid.Column="1" Classes="card" Padding="16" IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding SelectedProject.Title, FallbackValue='Выберите проект'}" Classes="h2"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedProject.Description}" Classes="body" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="chip"><TextBlock Text="{Binding SelectedProject.Author, FallbackValue='—'}" Classes="caption" /></Border>
              <Border Classes="chip"><TextBlock Text="{Binding SelectedProject.License, FallbackValue='лицензия н/д'}" Classes="caption" /></Border>
            </StackPanel>

            <Border Classes="divider" />
            <TextBlock Text="Версии" Classes="h3" />
            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                     MaxHeight="220" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="content:ContentVersion">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding VersionNumber}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding GameVersions, Converter={x:Static vm:TextConverters.JoinList}}"
                               Classes="caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Classes="primary" Content="Установить в профиль" HorizontalAlignment="Stretch"
                    Command="{Binding InstallCommand}" />

            <StackPanel IsVisible="{Binding IsInstalling}" Spacing="5">
              <TextBlock Text="{Binding InstallStage}" Classes="caption" />
              <ProgressBar Classes="ehot" Value="{Binding InstallProgress}" Maximum="1" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
