<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             xmlns:content="using:EHOT.Launcher.Content.Models"
             xmlns:storage="using:EHOT.Launcher.Core.Models"
             xmlns:imgs="using:EHOT.Launcher.UI.Converters"
             xmlns:controls="using:EHOT.Launcher.UI.Controls"
             x:Class="EHOT.Launcher.UI.Views.ContentBrowseView"
             x:DataType="vm:ContentBrowseViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">

    <!-- ══════ Заголовок раздела + инструменты ══════ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{Binding Subtitle}" Classes="body" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                  Width="196" ToolTip.Tip="Сортировка результатов" />
        <Button Classes="ghost" Command="{Binding ToggleInstalledCommand}" ToolTip.Tip="Показать установленное">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource IconFolder}" Classes="icon" Width="15" Height="15" />
            <TextBlock Text="Установленное" FontSize="12.5" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══════ Поиск ══════ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding Query, Mode=TwoWay}" PlaceholderText="Поиск: название, описание, тег" />
      <Button Grid.Column="1" Classes="primary" MinWidth="118" Content="Найти"
              Command="{Binding SearchCommand}" />
    </Grid>

    <!-- ══════ Результаты + детали ══════ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">

      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <Border Grid.Row="0" Padding="12,10" CornerRadius="12" Background="#141B2B"
                BorderBrush="#22304A" BorderThickness="1"
                IsVisible="{Binding HasProviderNotice}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Path Data="{StaticResource IconInfo}" Classes="icon blue" Width="15" Height="15" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding ProviderNotice}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding TotalHits, StringFormat='Найдено: {0}'}" Classes="caption"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Content="Загрузить ещё" FontSize="12" Padding="12,6"
                  Command="{Binding LoadMoreCommand}" />
        </Grid>

        <!-- Результаты -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowInstalled, Converter={x:Static BoolConverters.Not}}">
          <StackPanel Spacing="2">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContentCard">
                  <Border Margin="0,0,12,12" CornerRadius="14" Padding="14"
                          Background="#151B28" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                          Cursor="Hand">
                    <StackPanel Spacing="10">

                      <!-- Аватар проекта: настоящая иконка с CDN, пока грузится — первая буква названия -->
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border Width="52" Height="52" CornerRadius="13" Background="#1E2740"
                                BorderBrush="#26314A" BorderThickness="1" ClipToBounds="True">
                          <Panel>
                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="20"
                                       Foreground="#C4B5FD"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasIcon}" />
                            <controls:RemoteImage Url="{Binding IconUrl}"
                                                  Stretch="Uniform" Width="46" Height="46"
                                                  IsVisible="{Binding HasIcon}" />
                          </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                     Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                     MaxLines="1" />
                          <TextBlock Text="{Binding Author}" Classes="caption" FontSize="11"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <TextBlock Text="{Binding TypeLabel}" Classes="caption" FontSize="10"
                                     Foreground="{StaticResource AccentBlueBrush}" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" MaxLines="3"
                                 Height="48" TextTrimming="CharacterEllipsis" />

                      <!-- Метрики -->
                      <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Path Data="{StaticResource IconDownload}" Classes="icon" Width="13" Height="13" />
                          <TextBlock Text="{Binding DownloadsLabel}" Classes="caption" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CategoriesLabel}" Classes="caption" FontSize="11"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </Grid>

                      <Button Classes="pill" Content="Открыть" HorizontalAlignment="Stretch"
                              Command="{Binding $parent[ItemsControl].((vm:ContentBrowseViewModel)DataContext).OpenProjectCommand}"
                              CommandParameter="{Binding Project}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ничего не найдено. Измените запрос, версию игры или сортировку." Classes="caption"
                       Margin="2,10,0,0"
                       IsVisible="{Binding Items.Count, Converter={x:Static vm:TextConverters.IsZero}}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Установленное -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowInstalled}">
          <ItemsControl ItemsSource="{Binding InstalledItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="storage:InstalledContent">
                <Border CornerRadius="12" Margin="0,0,0,8" Padding="14" Background="#151B28"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" FontSize="13"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding FileName}" Classes="caption" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="danger" Padding="12,5" FontSize="11.5" Content="Удалить"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:ContentBrowseViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- ══════ Детали проекта ══════ -->
      <Border Grid.Column="1" Width="332" CornerRadius="16" Padding="16" Background="#141A26"
              BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
              IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer>
          <StackPanel Spacing="12">

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="44" Height="44" CornerRadius="12" Background="#1E2740">
                <TextBlock Text="{Binding SelectedProject.Title, Converter={x:Static vm:TextConverters.FirstLetter}}"
                           FontWeight="Bold" FontSize="17" Foreground="#C4B5FD"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding SelectedProject.Title}" Classes="h2" TextWrapping="Wrap" MaxWidth="230" />
                <TextBlock Text="{Binding SelectedProject.Author, FallbackValue='автор не указан'}" Classes="caption" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding SelectedProject.Description}" Classes="body" TextWrapping="Wrap"
                       MaxHeight="140" />

            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="chip" Padding="9,3">
                <TextBlock Text="{Binding SelectedProject.License, FallbackValue='лицензия н/д'}" Classes="caption"
                           FontSize="10.5" />
              </Border>
              <Border Classes="chip" Padding="9,3">
                <TextBlock Text="{Binding SelectedProject.Downloads, StringFormat='{}{0:N0} загрузок'}"
                           Classes="caption" FontSize="10.5" />
              </Border>
            </StackPanel>

            <Border Classes="divider" />

            <TextBlock Text="Версии" Classes="h3" />
            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                     MaxHeight="200" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="content:ContentVersion">
                  <StackPanel Spacing="1" Margin="2,4">
                    <TextBlock Text="{Binding VersionNumber}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding GameVersions, Converter={x:Static vm:TextConverters.JoinList}}"
                               Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Classes="primary" Content="Установить в профиль" HorizontalAlignment="Stretch"
                    Command="{Binding InstallCommand}" />

            <StackPanel IsVisible="{Binding IsInstalling}" Spacing="6">
              <TextBlock Text="{Binding InstallStage}" Classes="caption" />
              <ProgressBar Classes="ehot" Value="{Binding InstallProgress}" Maximum="1" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
