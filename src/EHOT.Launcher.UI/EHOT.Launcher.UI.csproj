<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EHOT.Launcher.UI</RootNamespace>
    <AssemblyName>EHOT.Launcher</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/ehot.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EHOT.Launcher.Core/EHOT.Launcher.Core.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Platform/EHOT.Launcher.Platform.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Platform.Windows/EHOT.Launcher.Platform.Windows.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Platform.MacOS/EHOT.Launcher.Platform.MacOS.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Platform.Linux/EHOT.Launcher.Platform.Linux.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Storage/EHOT.Launcher.Storage.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Auth/EHOT.Launcher.Auth.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Game/EHOT.Launcher.Game.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Content/EHOT.Launcher.Content.csproj" />
    <ProjectReference Include="../EHOT.Launcher.Network/EHOT.Launcher.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EHOT.Launcher.Update/EHOT.Launcher.Update.csproj" />
  </ItemGroup>

  <!-- Канал обновлений: отдельный ПУБЛИЧНЫЙ репозиторий с установщиками
       (исходный код остаётся в закрытом репозитории). Переопределяется в CI:
       -p:UpdateRepository=owner/repo -->
  <PropertyGroup>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">Timofei2506/EHOT-Launcher-Releases</UpdateRepository>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
</Project>
