<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:EHOT.Launcher.UI"
             xmlns:vm="using:EHOT.Launcher.UI.ViewModels"
             x:Class="EHOT.Launcher.UI.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EHOT.Launcher/DesignSystem/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://EHOT.Launcher/DesignSystem/Controls.axaml" />
  </Application.Styles>

</Application>
