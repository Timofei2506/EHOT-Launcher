{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/downloads/(.*).(exe|dmg)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*).(css|js|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/EHOT-Launcher-0.2.0-win-x64-setup.exe",
      "destination": "https://github.com/Timofei2506/EHOT-Launcher-Releases/releases/download/v0.2.0/EHOT-Launcher-0.2.0-win-x64-setup.exe"
    },
    {
      "source": "/downloads/EHOT-Launcher-0.2.0-osx-arm64.dmg",
      "destination": "https://github.com/Timofei2506/EHOT-Launcher-Releases/releases/download/v0.2.0/EHOT-Launcher-0.2.0-osx-arm64.dmg"
    },
    {
      "source": "/downloads/EHOT-Launcher-0.2.0-osx-x64.dmg",
      "destination": "https://github.com/Timofei2506/EHOT-Launcher-Releases/releases/download/v0.2.0/EHOT-Launcher-0.2.0-osx-x64.dmg"
    },
    {
      "source": "/downloads/EHOT-Launcher-:file",
      "destination": "https://github.com/Timofei2506/EHOT-Launcher-Releases/releases/latest/download/EHOT-Launcher-:file"
    }
  ]
}
